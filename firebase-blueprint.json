        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "movementType",
        "skuCode",
        "medicineName",
        "batchId",
        "batchNumber",
        "hubId",
        "hubName",
        "targetHubId",
        "targetHubName",
        "quantityDelta",
        "quantityAfter",
        "unit",
        "reason",
        "actorUid",
        "actorEmail",
        "timestampIso",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Distributor workspace configuration and ownership root."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Operational user profile (no PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated user PII (email address) restricted strictly to owner."
    },
    "/inventoryBatches/{batchId}": {
      "schema": { "$ref": "#/entities/InventoryBatch" },
      "description": "Pharmaceutical inventory batches owned by distributor workspace."
    },
    "/salesHistory/{recordId}": {
      "schema": { "$ref": "#/entities/SalesHistoryRecord" },
      "description": "Historical monthly consumption records for moving-average forecasting."
    },
    "/stockTransfers/{transferId}": {
      "schema": { "$ref": "#/entities/StockTransfer" },
      "description": "Inter-hub stock transfer orders across Northeast India."
    },
    "/stockMovements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Immutable stock movement and audit ledger."
    },
    "/recommendations/{recId}": {
      "schema": { "$ref": "#/entities/RecommendationAction" },
      "description": "Deterministic recommendation action tracking."
    }
  }
}
