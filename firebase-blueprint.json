{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "Distributor organization workspace in Northeast India.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the workspace owner."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Distributor company or hub network name."
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Operating region (e.g., Northeast India)."
        },
        "primaryHubId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Primary distribution hub identifier."
        },
        "seeded": {
          "type": "boolean",
          "description": "Whether synthetic demonstration data has been seeded."
        },
        "hubOverrides": {
          "type": "object",
          "description": "Optional per-hub lead time and monsoon buffer overrides."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["ownerId", "name", "region", "primaryHubId", "seeded", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII public/operational user record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Assigned workspace ID."
        },
        "role": {
          "type": "string",
          "enum": ["distributor_manager", "inventory_analyst"],
          "description": "Operational role within workspace."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "workspaceId", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for user contact details.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "createdAt", "updatedAt"]
    },
    "InventoryBatch": {
      "title": "InventoryBatch",
      "description": "Pharmaceutical stock batch tracked by expiry, hub, and cold-chain requirements.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "skuCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "medicineName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "genericName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": [
            "Antibiotics",
            "Antidiabetics",
            "Cardiovascular",
            "Pediatrics & ORS",
            "Cold-Chain Biologics",
            "Analgesics & Antipyretics"
          ]
        },
        "batchNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "hubId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hubName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "quantity": {
          "type": "integer"
        },
        "unit": {
          "type": "string",
          "enum": ["Strips", "Vials", "Bottles", "Boxes", "Sachets", "Prefilled Syringes"]
        },
        "reorderLevel": {
          "type": "integer"
        },
        "unitCostInr": {
          "type": "number"
        },
        "mrpInr": {
          "type": "number"
        },
        "expiryDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "storageCondition": {
          "type": "string",
          "enum": ["Ambient (15-25°C)", "Cold Chain (2-8°C)", "Cool Dry (<20°C)"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "quarantined", "depleted"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "skuCode",
        "medicineName",
        "genericName",
        "category",
        "batchNumber",
        "manufacturer",
        "hubId",
        "hubName",
        "quantity",
        "unit",
        "reorderLevel",
        "unitCostInr",
        "mrpInr",
        "expiryDate",
        "storageCondition",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SalesHistoryRecord": {
      "title": "SalesHistoryRecord",
      "description": "Monthly SKU demand and sales record used for moving-average forecasting.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "skuCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "medicineName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": [
            "Antibiotics",
            "Antidiabetics",
            "Cardiovascular",
            "Pediatrics & ORS",
            "Cold-Chain Biologics",
            "Analgesics & Antipyretics"
          ]
        },
        "hubId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "month": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "unitsSold": {
          "type": "integer"
        },
        "revenueInr": {
          "type": "number"
        },
        "seasonalFactor": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "skuCode",
        "medicineName",
        "category",
        "hubId",
        "month",
        "unitsSold",
        "revenueInr",
        "seasonalFactor",
        "createdAt",
        "updatedAt"
      ]
    },
    "StockTransfer": {
      "title": "StockTransfer",
      "description": "Inter-hub pharmaceutical stock transfer across Northeast India corridors.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "batchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "skuCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "medicineName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "batchNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "fromHubId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromHubName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "toHubId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toHubName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "quantity": {
          "type": "integer"
        },
        "unit": {
          "type": "string",
          "enum": ["Strips", "Vials", "Bottles", "Boxes", "Sachets", "Prefilled Syringes"]
        },
        "estimatedValueInr": {
          "type": "number"
        },
        "transportMode": {
          "type": "string",
          "enum": ["Cold-Chain Van", "Express Highway Cargo", "Hill-Route Insulated Carrier"]
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_transit", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "batchId",
        "skuCode",
        "medicineName",
        "batchNumber",
        "fromHubId",
        "fromHubName",
        "toHubId",
        "toHubName",
        "quantity",
        "unit",
        "estimatedValueInr",
        "transportMode",
        "reason",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "RecommendationAction": {
      "title": "RecommendationAction",
      "description": "Deterministic business-rule recommendation state persisted in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ruleId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "warning", "info"]
        },
        "actionType": {
          "type": "string",
          "enum": ["transfer", "reorder", "clearance", "quarantine", "buffer"]
        },
        "skuCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "medicineName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "batchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hubId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetHubId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "suggestedQty": {
          "type": "integer"
        },
        "estimatedImpactInr": {
          "type": "number"
        },
        "rationale": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["open", "applied", "dismissed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "ruleId",
        "priority",
        "actionType",
        "skuCode",
        "medicineName",
        "batchId",
        "hubId",
        "targetHubId",
        "suggestedQty",
        "estimatedImpactInr",
        "rationale",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Immutable append-only stock movement and adjustment audit log.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "movementType": {
          "type": "string",
          "enum": [
            "batch_add",
            "stock_adjust",
            "quarantine",
            "clearance",
            "reorder_receive",
            "transfer_out",
            "transfer_in",
            "transfer_cancel"
          ]
        },
        "skuCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "medicineName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "batchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "batchNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "hubId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hubName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "targetHubId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "targetHubName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "quantityDelta": {
          "type": "integer"
        },
        "quantityAfter": {
          "type": "integer"
        },
        "unit": {
          "type": "string",
          "enum": ["Strips", "Vials", "Bottles", "Boxes", "Sachets", "Prefilled Syringes"]
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
